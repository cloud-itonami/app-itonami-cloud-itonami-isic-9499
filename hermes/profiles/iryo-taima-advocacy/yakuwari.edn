;; Authority for the iryo-taima-advocacy profile (AWAI-3656, parent AWAI-3655).
;; Unlisted capabilities are denied. The list is copied into itonami.edn and
;; grants nothing by itself -- this file is the authority.
;; Owner instruction 2026-11-21: the bot runs autonomously and posts on aozora.app.
{:yakuwari/id :iryo-taima-advocacy
 :yakuwari/capabilities
 [{:capability :read_public_sources :decision :autonomous
   :note "public government, legislature, regulator and peer-reviewed sources only"}
  {:capability :draft_post :decision :autonomous}
  {:capability :post_aozora :decision :autonomous
   :note "only through scripts/aozora_post.py, which refuses any draft post_guard.py rejects and queues for a human approver any draft review.py holds (Legal policy A, AWAI-3655)"}
  {:capability :reply_aozora :decision :blocked
   :note "no replies or direct messages: an individual question may be a medical or legal consultation"}
  {:capability :publish_organization_position :decision :approval-required
   :note "an official position of the operating organization stays human-gated (memberorg :actuation/publish-position)"}
  {:capability :post_other_networks :decision :blocked}
  {:capability :create_account :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :modify_source :decision :blocked}
  {:capability :handle_personal_health_data :decision :blocked}]
 :yakuwari/runners [{:runner :itonami :weight 1}]}
